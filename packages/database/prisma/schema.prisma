generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MEMBER
  TRAINER
  STAFF
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// EXPIRED is derived in contracts from ACTIVE + endDate; no cron write required.
enum SubscriptionStatus {
  UPCOMING
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  CANCELLED
}

enum BookingStatus {
  BOOKED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum AttendanceStatus {
  PENDING
  PRESENT
  ABSENT
  NO_SHOW
}

enum QuotaTransactionType {
  RESERVE
  USE
  REFUND
  ADJUST
}

enum CheckinStatus {
  ACCEPTED
  REJECTED
}

enum ScheduleStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum FreezeStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum PtPurchaseOrigin {
  STANDALONE
  LEGACY_BUNDLED
}

enum PtPurchaseStatus {
  PENDING_PAYMENT
  ACTIVE
  EXHAUSTED
  EXPIRED
  CANCELLED
  REFUNDED
}

model User {
  id                   String               @id @default(uuid()) @db.Uuid
  email                String               @unique
  passwordHash         String               @map("password_hash")
  refreshTokenHash     String?              @map("refresh_token_hash")
  isActive             Boolean              @default(true) @map("is_active")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  roles                UserRoleAssignment[]
  memberProfile        MemberProfile?
  employeeProfile      EmployeeProfile?
  createdSubscriptions Subscription[]       @relation("SubscriptionCreator")
  createdPtPurchases   PtPackagePurchase[]  @relation("PtPurchaseCreator")
  confirmedPayments    PaymentRecord[]      @relation("PaymentConfirmer")
  quotaTransactions    QuotaTransaction[]   @relation("QuotaActor")
  recordedCheckins     Checkin[]            @relation("CheckinRecorder")
  approvedFreezes      SubscriptionFreeze[] @relation("FreezeApprover")
  notifications        Notification[]
  sessions             AuthSession[]
  auditLogs            AuditLog[]

  @@map("users")
}

model AuthSession {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Role {
  id    String               @id @default(uuid()) @db.Uuid
  code  UserRole             @unique
  name  String
  users UserRoleAssignment[]

  @@map("roles")
}

model UserRoleAssignment {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model MemberProfile {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @unique @map("user_id") @db.Uuid
  fullName           String              @map("full_name")
  phone              String?
  gender             Gender?
  dateOfBirth        DateTime?           @map("date_of_birth") @db.Date
  idPhotoUrl         String?             @map("id_photo_url")
  facePhotoVersion   String?             @map("face_photo_version")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscriptions      Subscription[]
  checkins           Checkin[]
  classBookings      ClassBooking[]
  ptBookings         PtBooking[]
  ptPackagePurchases PtPackagePurchase[]

  faceDescriptor MemberFaceDescriptor?

  @@map("member_profiles")
}

model EmployeeProfile {
  id                    String           @id @default(uuid()) @db.Uuid
  userId                String           @unique @map("user_id") @db.Uuid
  fullName              String           @map("full_name")
  phone                 String?
  specialization        String?
  specialties           String[]         @default([])
  canTeachClasses       Boolean          @default(false) @map("can_teach_classes")
  canCoachPt            Boolean          @default(false) @map("can_coach_pt")
  hiredAt               DateTime?        @map("hired_at") @db.Date
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                  User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  availability          PtAvailability[]
  classSchedules        ClassSchedule[]
  ptBookings            PtBooking[]
  assignedSubscriptions Subscription[]   @relation("SubscriptionAssignedTrainer")

  @@map("employee_profiles")
}

model MembershipPlan {
  id            String            @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  durationDays  Int               @map("duration_days")
  price         Decimal           @db.Decimal(14, 2)
  isActive      Boolean           @default(true) @map("is_active")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  entitlements  PlanEntitlement[]
  subscriptions Subscription[]

  @@map("membership_plans")
}

model ServiceType {
  id           String              @id @default(uuid()) @db.Uuid
  code         String              @unique
  name         String
  entitlements PlanEntitlement[]
  quotas       SubscriptionQuota[]

  @@map("service_types")
}

model PlanEntitlement {
  id            String         @id @default(uuid()) @db.Uuid
  planId        String         @map("plan_id") @db.Uuid
  serviceTypeId String         @map("service_type_id") @db.Uuid
  // null = unlimited; absence of entitlement = no access.
  allocated     Int?
  plan          MembershipPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  serviceType   ServiceType    @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)

  @@unique([planId, serviceTypeId])
  @@index([serviceTypeId])
  @@map("plan_entitlements")
}

model Subscription {
  assignedTrainerId      String?              @map("assigned_trainer_id") @db.Uuid
  ptAssignmentVersion    Int                  @default(0) @map("pt_assignment_version")
  assignedTrainer        EmployeeProfile?     @relation("SubscriptionAssignedTrainer", fields: [assignedTrainerId], references: [id], onDelete: Restrict)
  id                     String               @id @default(uuid()) @db.Uuid
  memberId               String               @map("member_id") @db.Uuid
  planId                 String               @map("plan_id") @db.Uuid
  previousSubscriptionId String?              @unique @map("previous_subscription_id") @db.Uuid
  startDate              DateTime             @map("start_date") @db.Timestamptz(3)
  endDate                DateTime             @map("end_date") @db.Timestamptz(3)
  status                 SubscriptionStatus   @default(UPCOMING)
  paymentStatus          PaymentStatus        @default(PENDING) @map("payment_status")
  // Snapshot price; future plan edits must not rewrite purchased terms.
  agreedPrice            Decimal              @map("agreed_price") @db.Decimal(14, 2)
  activatedAt            DateTime?            @map("activated_at") @db.Timestamptz(3)
  cancelledAt            DateTime?            @map("cancelled_at") @db.Timestamptz(3)
  cancelReason           String?              @map("cancel_reason")
  createdBy              String?              @map("created_by") @db.Uuid
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  member                 MemberProfile        @relation(fields: [memberId], references: [id], onDelete: Restrict)
  plan                   MembershipPlan       @relation(fields: [planId], references: [id], onDelete: Restrict)
  previousSubscription   Subscription?        @relation("Renewal", fields: [previousSubscriptionId], references: [id], onDelete: Restrict)
  nextSubscription       Subscription?        @relation("Renewal")
  creator                User?                @relation("SubscriptionCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  quotas                 SubscriptionQuota[]
  freezes                SubscriptionFreeze[]
  payments               PaymentRecord[]
  quotaTransactions      QuotaTransaction[]
  checkins               Checkin[]
  classBookings          ClassBooking[]
  ptBookings             PtBooking[]          @relation("PtBookingCoverageSubscription")
  sourcedPtBookings      PtBooking[]          @relation("PtBookingSourceSubscription")
  ptPackagePurchases     PtPackagePurchase[]

  @@unique([id, memberId])
  @@index([assignedTrainerId, endDate])
  @@index([memberId, status])
  @@index([status, startDate])
  @@index([status, endDate])
  @@index([planId])
  @@index([createdBy])
  @@map("subscriptions")
}

model SubscriptionQuota {
  id                 String              @id @default(uuid()) @db.Uuid
  subscriptionId     String              @map("subscription_id") @db.Uuid
  serviceTypeId      String              @map("service_type_id") @db.Uuid
  // Purchased entitlement snapshot. null allocated means unlimited.
  allocated          Int?
  reserved           Int                 @default(0)
  used               Int                 @default(0)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  subscription       Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  serviceType        ServiceType         @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)
  transactions       QuotaTransaction[]
  checkins           Checkin[]
  classBookings      ClassBooking[]
  ptBookings         PtBooking[]
  ptPackagePurchases PtPackagePurchase[]

  @@unique([subscriptionId, serviceTypeId])
  @@unique([id, subscriptionId])
  @@index([serviceTypeId])
  @@map("subscription_quotas")
}

model SubscriptionFreeze {
  id             String       @id @default(uuid()) @db.Uuid
  subscriptionId String       @map("subscription_id") @db.Uuid
  startsAt       DateTime     @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime     @map("ends_at") @db.Timestamptz(3)
  freezeDays     Int          @map("freeze_days")
  status         FreezeStatus @default(REQUESTED)
  reason         String?
  approvedBy     String?      @map("approved_by") @db.Uuid
  // Set atomically with endDate extension to prevent double extension.
  restoredAt     DateTime?    @map("restored_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  approver       User?        @relation("FreezeApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([subscriptionId, status])
  @@index([status, endsAt])
  @@index([approvedBy])
  @@map("subscription_freezes")
}

model PaymentRecord {
  id             String             @id @default(uuid()) @db.Uuid
  subscriptionId String?            @map("subscription_id") @db.Uuid
  ptPurchaseId   String?            @map("pt_purchase_id") @db.Uuid
  amount         Decimal            @db.Decimal(14, 2)
  currency       String             @default("VND") @db.VarChar(3)
  status         PaymentStatus      @default(PENDING)
  method         String?
  note           String?
  confirmedBy    String?            @map("confirmed_by") @db.Uuid
  confirmedAt    DateTime?          @map("confirmed_at") @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  subscription   Subscription?      @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  ptPurchase     PtPackagePurchase? @relation(fields: [ptPurchaseId], references: [id], onDelete: Restrict)
  confirmer      User?              @relation("PaymentConfirmer", fields: [confirmedBy], references: [id], onDelete: SetNull)

  @@index([subscriptionId, status])
  @@index([ptPurchaseId, status])
  @@index([confirmedBy])
  @@map("payment_records")
}

model QuotaTransaction {
  id             String               @id @default(uuid()) @db.Uuid
  quotaId        String?              @map("quota_id") @db.Uuid
  subscriptionId String?              @map("subscription_id") @db.Uuid
  ptPurchaseId   String?              @map("pt_purchase_id") @db.Uuid
  type           QuotaTransactionType
  allocatedDelta Int                  @default(0) @map("allocated_delta")
  reservedDelta  Int                  @default(0) @map("reserved_delta")
  usedDelta      Int                  @default(0) @map("used_delta")
  idempotencyKey String               @unique @map("idempotency_key")
  // Reference to booking/checkin being changed; recorded in the same transaction.
  referenceType  String?              @map("reference_type")
  referenceId    String?              @map("reference_id") @db.Uuid
  reason         String?
  createdBy      String?              @map("created_by") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  quota          SubscriptionQuota?   @relation(fields: [quotaId, subscriptionId], references: [id, subscriptionId], onDelete: Restrict)
  subscription   Subscription?        @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  ptPurchase     PtPackagePurchase?   @relation(fields: [ptPurchaseId], references: [id], onDelete: Restrict)
  actor          User?                @relation("QuotaActor", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([quotaId, createdAt])
  @@index([subscriptionId])
  @@index([ptPurchaseId, createdAt])
  @@index([createdBy])
  @@map("quota_transactions")
}

model Checkin {
  requestId       String?            @unique @map("request_id")
  gateIdentifier  String?            @map("gate_identifier")
  id              String             @id @default(uuid()) @db.Uuid
  memberId        String             @map("member_id") @db.Uuid
  // Nullable so rejected attempts without a valid subscription can be recorded.
  subscriptionId  String?            @map("subscription_id") @db.Uuid
  quotaId         String?            @map("quota_id") @db.Uuid
  status          CheckinStatus
  rejectionReason String?            @map("rejection_reason")
  checkedInAt     DateTime           @default(now()) @map("checked_in_at") @db.Timestamptz(3)
  recordedBy      String?            @map("recorded_by") @db.Uuid
  member          MemberProfile      @relation(fields: [memberId], references: [id], onDelete: Restrict)
  subscription    Subscription?      @relation(fields: [subscriptionId, memberId], references: [id, memberId], onDelete: Restrict)
  quota           SubscriptionQuota? @relation(fields: [quotaId, subscriptionId], references: [id, subscriptionId], onDelete: Restrict)
  recorder        User?              @relation("CheckinRecorder", fields: [recordedBy], references: [id], onDelete: SetNull)

  @@index([memberId, checkedInAt])
  @@index([subscriptionId])
  @@index([quotaId])
  @@index([recordedBy])
  @@map("checkins")
}

model GymClass {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  description String?
  isActive    Boolean         @default(true) @map("is_active")
  schedules   ClassSchedule[]

  @@map("classes")
}

model ClassSchedule {
  id        String          @id @default(uuid()) @db.Uuid
  classId   String          @map("class_id") @db.Uuid
  trainerId String          @map("trainer_id") @db.Uuid
  startsAt  DateTime        @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime        @map("ends_at") @db.Timestamptz(3)
  capacity  Int
  status    ScheduleStatus  @default(SCHEDULED)
  gymClass  GymClass        @relation(fields: [classId], references: [id], onDelete: Restrict)
  trainer   EmployeeProfile @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  bookings  ClassBooking[]

  @@index([classId, startsAt])
  @@index([trainerId, startsAt])
  @@map("class_schedules")
}

model ClassBooking {
  id             String            @id @default(uuid()) @db.Uuid
  scheduleId     String            @map("schedule_id") @db.Uuid
  memberId       String            @map("member_id") @db.Uuid
  subscriptionId String            @map("subscription_id") @db.Uuid
  quotaId        String            @map("quota_id") @db.Uuid
  status         BookingStatus     @default(BOOKED)
  attendance     AttendanceStatus  @default(PENDING)
  cancelledAt    DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  attendedAt     DateTime?         @map("attended_at") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  schedule       ClassSchedule     @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  member         MemberProfile     @relation(fields: [memberId], references: [id], onDelete: Restrict)
  subscription   Subscription      @relation(fields: [subscriptionId, memberId], references: [id, memberId], onDelete: Restrict)
  quota          SubscriptionQuota @relation(fields: [quotaId, subscriptionId], references: [id, subscriptionId], onDelete: Restrict)

  // Rebooking updates this record; audit log retains transitions.
  @@unique([scheduleId, memberId])
  @@index([memberId, status])
  @@index([subscriptionId])
  @@index([quotaId])
  @@map("class_bookings")
}

model PtAvailability {
  id          String          @id @default(uuid()) @db.Uuid
  trainerId   String          @map("trainer_id") @db.Uuid
  startsAt    DateTime        @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime        @map("ends_at") @db.Timestamptz(3)
  isAvailable Boolean         @default(true) @map("is_available")
  note        String?
  trainer     EmployeeProfile @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  bookings    PtBooking[]

  @@unique([id, trainerId])
  @@index([trainerId, startsAt])
  @@map("pt_availability")
}

model PtBooking {
  id                   String             @id @default(uuid()) @db.Uuid
  memberId             String             @map("member_id") @db.Uuid
  trainerId            String             @map("trainer_id") @db.Uuid
  // Covering Gym subscription at appointment time (must belong to memberId).
  subscriptionId       String             @map("subscription_id") @db.Uuid
  // Credit source subscription when funded by legacy PT quota (null for standalone PT purchases).
  sourceSubscriptionId String?            @map("source_subscription_id") @db.Uuid
  quotaId              String?            @map("quota_id") @db.Uuid
  ptPurchaseId         String?            @map("pt_purchase_id") @db.Uuid
  availabilityId       String?            @map("availability_id") @db.Uuid
  startsAt             DateTime           @map("starts_at") @db.Timestamptz(3)
  endsAt               DateTime           @map("ends_at") @db.Timestamptz(3)
  status               BookingStatus      @default(BOOKED)
  attendance           AttendanceStatus   @default(PENDING)
  cancelledAt          DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  attendedAt           DateTime?          @map("attended_at") @db.Timestamptz(3)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  member               MemberProfile      @relation(fields: [memberId], references: [id], onDelete: Restrict)
  trainer              EmployeeProfile    @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  subscription         Subscription       @relation("PtBookingCoverageSubscription", fields: [subscriptionId, memberId], references: [id, memberId], onDelete: Restrict)
  sourceSubscription   Subscription?      @relation("PtBookingSourceSubscription", fields: [sourceSubscriptionId, memberId], references: [id, memberId], onDelete: Restrict)
  quota                SubscriptionQuota? @relation(fields: [quotaId, sourceSubscriptionId], references: [id, subscriptionId], onDelete: Restrict)
  ptPurchase           PtPackagePurchase? @relation(fields: [ptPurchaseId, memberId], references: [id, memberId], onDelete: Restrict)
  availability         PtAvailability?    @relation(fields: [availabilityId, trainerId], references: [id, trainerId], onDelete: Restrict)

  @@index([trainerId, startsAt, endsAt])
  @@index([memberId, startsAt])
  @@index([subscriptionId, status])
  @@index([sourceSubscriptionId, status])
  @@index([quotaId])
  @@index([ptPurchaseId, status])
  @@index([availabilityId])
  @@map("pt_bookings")
}

model PtPackagePlan {
  id             String              @id @default(uuid()) @db.Uuid
  code           String              @unique
  name           String
  description    String?
  sessionCount   Int                 @map("session_count")
  sessionMinutes Int                 @default(60) @map("session_minutes")
  price          Decimal             @db.Decimal(14, 2)
  isActive       Boolean             @default(true) @map("is_active")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  purchases      PtPackagePurchase[]

  @@map("pt_package_plans")
}

model PtPackagePurchase {
  id                     String             @id @default(uuid()) @db.Uuid
  memberId               String             @map("member_id") @db.Uuid
  origin                 PtPurchaseOrigin
  ptPlanId               String?            @map("pt_plan_id") @db.Uuid
  sourceSubscriptionId   String?            @unique @map("source_subscription_id") @db.Uuid
  legacyQuotaId          String?            @unique @map("legacy_quota_id") @db.Uuid
  packageCodeSnapshot    String?            @map("package_code_snapshot")
  packageNameSnapshot    String             @map("package_name_snapshot")
  sessionCountSnapshot   Int?               @map("session_count_snapshot")
  sessionMinutesSnapshot Int                @default(60) @map("session_minutes_snapshot")
  // null allocated is allowed only for legacy unlimited PT rights; standalone purchases require positive allocated.
  allocated              Int?
  reserved               Int                @default(0)
  used                   Int                @default(0)
  // Snapshot monetary amount; null for legacy converted rights (no synthetic revenue).
  agreedPrice            Decimal?           @map("agreed_price") @db.Decimal(14, 2)
  currency               String?            @db.VarChar(3)
  paymentStatus          PaymentStatus      @default(PENDING) @map("payment_status")
  status                 PtPurchaseStatus   @default(PENDING_PAYMENT)
  originalStartDate      DateTime?          @map("original_start_date") @db.Timestamptz(3)
  originalEndDate        DateTime?          @map("original_end_date") @db.Timestamptz(3)
  cutoverAt              DateTime?          @map("cutover_at") @db.Timestamptz(3)
  cutoverEligible        Boolean?           @map("cutover_eligible")
  createdBy              String?            @map("created_by") @db.Uuid
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  member                 MemberProfile      @relation(fields: [memberId], references: [id], onDelete: Restrict)
  ptPlan                 PtPackagePlan?     @relation(fields: [ptPlanId], references: [id], onDelete: Restrict)
  sourceSubscription     Subscription?      @relation(fields: [sourceSubscriptionId, memberId], references: [id, memberId], onDelete: Restrict)
  legacyQuota            SubscriptionQuota? @relation(fields: [legacyQuotaId, sourceSubscriptionId], references: [id, subscriptionId], onDelete: Restrict)
  creator                User?              @relation("PtPurchaseCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  payments               PaymentRecord[]
  quotaTransactions      QuotaTransaction[]
  ptBookings             PtBooking[]

  @@unique([id, memberId])
  @@unique([id, legacyQuotaId])
  @@unique([id, legacyQuotaId, sourceSubscriptionId])
  @@index([memberId, status])
  @@index([memberId, origin, status])
  @@index([ptPlanId])
  @@index([createdBy])
  @@map("pt_package_purchases")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String
  body      String
  data      Json?
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  // Never store password hashes, JWTs or secrets here.
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model MemberFaceDescriptor {
  memberId           String        @id @map("member_id") @db.Uuid
  modelVersion       String        @map("model_version")
  photoVersion       String        @map("photo_version")
  descriptor         Float[]
  mirroredDescriptor Float[]       @map("mirrored_descriptor")
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  member             MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("member_face_descriptors")
}

model StaffRequest {
  idempotencyKey String   @id @map("idempotency_key") @db.Uuid
  operation      String
  requestHash    String   @map("request_hash")
  entityId       String   @map("entity_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("staff_requests")
}
