{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "API_PORT",
    "WEB_ORIGIN",
    "JWT_ACCESS_SECRET",
    "JWT_REFRESH_SECRET",
    "JWT_ACCESS_EXPIRES_IN",
    "JWT_REFRESH_EXPIRES_IN",
    "REDIS_HOST",
    "REDIS_PORT",
    "NEXT_PUBLIC_API_URL",
    "API_INTERNAL_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@gym/database#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "src/generated/**"]
    },
    "@gym/database#typecheck": {
      "dependsOn": ["build"]
    },
    "@gym/contracts#test": {
      "dependsOn": ["build"]
    },
    "@gym/contracts#dev": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "@gym/database#dev": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "@gym/ui#dev": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    }
  }
}
